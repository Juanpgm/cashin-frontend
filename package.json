{
  "name": "cashin-frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "npm run start:dev",
    "prod": "npm run start:prod",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:APP_ENV='development'; Copy-Item .env.development .env.local -Force; expo start\"",
    "web:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:APP_ENV='development'; Copy-Item .env.development .env.local -Force; expo start --web\"",
    "start:prod": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:APP_ENV='production'; Copy-Item .env.production .env.local -Force; expo start\"",
    "web:prod": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:APP_ENV='production'; Copy-Item .env.production .env.local -Force; expo start --web\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/native": "^7.1.28",
    "amazon-cognito-identity-js": "^6.3.16",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "expo": "~55.0.6",
    "expo-camera": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.12",
    "expo-linking": "~55.0.7",
    "expo-notifications": "~55.0.12",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
